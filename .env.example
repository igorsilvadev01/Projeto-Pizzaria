# Configure somente se quiser oferecer Checkout Pro para retirada.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Contatos públicos opcionais. Preencha no servidor ou no painel administrativo.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_STORE_ADDRESS=
# Opcional: o banco padrão fica em .data/spadoni.sqlite.
SPADONI_DB_PATH=
# Opcional: sem esse valor, a chave inicial é gerada em .data/admin-setup.key.
ADMIN_SETUP_TOKEN=
# Compatibilidade opcional. Prefira criar o administrador em /admin/configurar.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
